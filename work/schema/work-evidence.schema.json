{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-evidence.schema.json",
  "title": "AutoRepo canonical work evidence event",
  "oneOf": [
    {
      "$ref": "#/$defs/STATE_TRANSITION"
    },
    {
      "$ref": "#/$defs/CLAIM_REQUEST"
    },
    {
      "$ref": "#/$defs/CLAIM"
    },
    {
      "$ref": "#/$defs/OPERATION_REQUEST"
    },
    {
      "$ref": "#/$defs/RENEW"
    },
    {
      "$ref": "#/$defs/RELEASE"
    },
    {
      "$ref": "#/$defs/HANDOFF"
    },
    {
      "$ref": "#/$defs/PAUSE"
    },
    {
      "$ref": "#/$defs/CANCEL_CLAIM"
    },
    {
      "$ref": "#/$defs/RECLAIM"
    },
    {
      "$ref": "#/$defs/REVIEW"
    },
    {
      "$ref": "#/$defs/PROVENANCE_ATTESTATION"
    },
    {
      "$ref": "#/$defs/PROVENANCE_REVIEW"
    },
    {
      "$ref": "#/$defs/ACCEPTANCE"
    },
    {
      "$ref": "#/$defs/WORK_ITEM_AMENDMENT"
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "github_actor",
        "kind"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "pattern": "^principal:(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "github_actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "maintainer"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "paths",
        "exclusive_resources"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@autorepo/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?:/\\*\\*)?$"
          },
          "uniqueItems": true
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        }
      }
    },
    "claimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "principal",
        "github_actor",
        "base_sha",
        "expires_at",
        "branch",
        "worktree",
        "packages",
        "paths",
        "exclusive_resources"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "principal": {
          "type": "string",
          "pattern": "^principal:(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "github_actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\.lock$)[A-Za-z0-9._/-]+(?<!/)$"
        },
        "worktree": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@autorepo/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?:/\\*\\*)?$"
          },
          "uniqueItems": true
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "principal",
        "github_actor",
        "base_sha",
        "expires_at",
        "branch",
        "worktree",
        "packages",
        "paths",
        "exclusive_resources",
        "request_sha"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "principal": {
          "type": "string",
          "pattern": "^principal:(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "github_actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\.lock$)[A-Za-z0-9._/-]+(?<!/)$"
        },
        "worktree": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@autorepo/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?:/\\*\\*)?$"
          },
          "uniqueItems": true
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        },
        "request_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "principal",
        "github_actor",
        "expires_at",
        "packages",
        "paths",
        "exclusive_resources"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "principal": {
          "type": "string",
          "pattern": "^principal:(?=[a-z0-9-]{3,80}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "github_actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        },
        "expires_at": {
          "type": "string",
