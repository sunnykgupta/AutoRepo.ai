{
  "name": "@autorepo/g1-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral Gate G1 repository validation tooling.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "clean-room:restricted-scan": "node scripts/clean-room/scan.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "validate:g1": "node scripts/g1-validate.mjs",
    "validate": "npm run format:check && npm run lint && npm test && npm run validate:g1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
