{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "state", "dependencies", "scope", "acceptance", "clean_room"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "state": { "enum": ["PROPOSED", "BLOCKED", "READY", "CLAIMED", "IN_REVIEW", "DONE", "CANCELLED"] },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$" }, "uniqueItems": true },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["packages", "paths", "exclusive_resources"],
      "properties": {
        "packages": { "type": "array", "items": { "type": "string", "pattern": "^@autorepo/[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?!/)(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?:/\\*\\*)?$" }, "uniqueItems": true },
        "exclusive_resources": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }, "uniqueItems": true }
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["required_checks"],
      "properties": { "required_checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 100 }, "uniqueItems": true } }
    },
    "clean_room": {
      "type": "object", "additionalProperties": false, "required": ["author_attestation_required", "provenance"],
      "properties": {
        "author_attestation_required": { "type": "boolean" },
        "provenance": { "enum": ["independently-authored", "independent-review-required"] }
      }
    }
  }
}
