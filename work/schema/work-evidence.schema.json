        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@autorepo/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+(?:/\\*\\*)?$"
          },
          "uniqueItems": true
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_sha",
        "merged_sha",
        "checks"
      ],
      "properties": {
        "tested_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "merged_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    "baseEvent": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "work_item_id",
        "sequence",
        "occurred_at",
        "type",
        "actor"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "work_item_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{1,63}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "enum": [
            "STATE_TRANSITION",
            "CLAIM_REQUEST",
            "CLAIM",
            "OPERATION_REQUEST",
            "RENEW",
            "RELEASE",
            "HANDOFF",
            "PAUSE",
            "CANCEL_CLAIM",
            "RECLAIM",
            "REVIEW",
            "PROVENANCE_ATTESTATION",
            "PROVENANCE_REVIEW",
            "ACCEPTANCE",
            "WORK_ITEM_AMENDMENT"
          ]
        },
        "actor": {
          "$ref": "#/$defs/actor"
        }
      }
    },
    "STATE_TRANSITION": {
      "title": "STATE_TRANSITION",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "STATE_TRANSITION"
            },
            "from_state": {
              "enum": [
                "PROPOSED",
                "BLOCKED",
                "READY",
                "CLAIMED",
                "IN_REVIEW",
                "DONE",
                "CANCELLED"
              ]
            },
            "to_state": {
              "enum": [
                "PROPOSED",
                "BLOCKED",
                "READY",
                "CLAIMED",
                "IN_REVIEW",
                "DONE",
                "CANCELLED"
              ]
            }
          },
          "required": [
            "from_state",
            "to_state"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "CLAIM_REQUEST": {
      "title": "CLAIM_REQUEST",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CLAIM_REQUEST"
            },
            "request": {
              "$ref": "#/$defs/claimRequest"
            }
          },
          "required": [
            "request"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "CLAIM": {
      "title": "CLAIM",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CLAIM"
            },
            "claim": {
