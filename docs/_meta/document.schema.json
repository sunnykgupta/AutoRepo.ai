{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "document_type", "status", "canonical_sources"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "document_type": { "enum": ["standard", "guide", "reference", "adr"] },
    "status": { "enum": ["active", "superseded", "template"] },
    "canonical_sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
